# Unreal Engine generated folders
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# Generated folders inside plugins
/Plugins/*/Binaries/
/Plugins/*/DerivedDataCache/
/Plugins/*/Intermediate/
/Plugins/*/Saved/

# Local developer-only Unreal content
/Content/Developers/

